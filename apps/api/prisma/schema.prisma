// Modelo de datos del Festival de Artes Vivas Loja.
// Documentación y decisiones: specs/001-base/data-model.md
// Los valores enumerados se guardan como String y se validan en src/domain/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Persona que usa el sistema. role: PUBLIC | ARTIST | ADMIN
model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("PUBLIC")
  createdAt    DateTime      @default(now())
  artist       Artist?
  reservations Reservation[]
}

/// Escenario o sede del festival.
model Venue {
  id           Int           @id @default(autoincrement())
  name         String
  address      String
  latitude     Float
  longitude    Float
  capacity     Int
  description  String        @default("")
  imageUrl     String?
  performances Performance[]
}

/// Artista solista o compañía. kind: SOLO | COMPANY
model Artist {
  id       Int     @id @default(autoincrement())
  name     String
  kind     String
  country  String
  bio      String  @default("")
  imageUrl String?
  website  String?
  userId   Int?    @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  events   Event[]
}

/// Obra o espectáculo. discipline: THEATER | DANCE | MUSIC | CIRCUS | STREET_ARTS
model Event {
  id              Int           @id @default(autoincrement())
  title           String
  discipline      String
  synopsis        String
  durationMinutes Int
  ageRating       String        @default("Todo público")
  imageUrl        String?
  artists         Artist[]
  performances    Performance[]

  @@index([discipline])
}

/// Función: presentación de una obra en un escenario y fecha. status: SCHEDULED | CANCELLED
model Performance {
  id           Int           @id @default(autoincrement())
  eventId      Int
  venueId      Int
  startsAt     DateTime
  capacity     Int
  status       String        @default("SCHEDULED")
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([startsAt])
  @@index([venueId])
  @@index([eventId])
}

/// Reserva de entradas. status: CONFIRMED | CANCELLED (las reservas no se borran, se cancelan)
model Reservation {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  userId        Int
  performanceId Int
  quantity      Int
  status        String      @default("CONFIRMED")
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  performance   Performance @relation(fields: [performanceId], references: [id], onDelete: Cascade)

  @@index([performanceId, status])
  @@index([userId])
}
