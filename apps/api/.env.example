# Copiar a .env:  cp apps/api/.env.example apps/api/.env
# Ruta de la base SQLite, relativa a la carpeta prisma/
DATABASE_URL="file:./dev.db"
PORT=3000
# Origen permitido por CORS (el frontend de Vite)
CORS_ORIGIN="http://localhost:5173"
# Reservado para la autenticación del Spec #3. Cambiar en cada entorno.
JWT_SECRET="cambia-este-secreto-en-local"
