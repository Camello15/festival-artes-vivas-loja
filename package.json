{
  "name": "festival-artes-vivas-loja",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo web del Festival Internacional de Artes Vivas de Loja (UTPL - Arquitectura de Software)",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev -w @festival/api\" \"npm:dev -w @festival/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "db:setup": "npm run db:setup -w @festival/api",
    "db:migrate": "npm run db:migrate -w @festival/api --",
    "db:seed": "npm run db:seed -w @festival/api",
    "db:studio": "npm run db:studio -w @festival/api"
  },
  "type": "module",
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
